<%layout("/layouts/boilerplate")%>

<body>
   <h1>All Listing</h1> 
   <!-- <form action="/listing/new" method="GET">
    <button>Create new</button>
   </form> -->
   <div class="row  row-cols-lg-3 row-cols-sm-1 row-cols-md-2">
      <%for(let listing of allListing){%>
         <div class="card" style="width: 18rem;">
            <img src="<%=listing.image%>" class="card-img-top" alt="listing_image">
            <div class="card-body">
              <p class="card-text">   
         
         <%=listing.title%> <br>
         ₹<%= listing.price%>/night
      
       
          </p>
            </div>
          </div>
          <%}%>
       
   </div>

</body>
</html>