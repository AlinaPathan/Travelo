<% layout("/layouts/boilerplate") %>

<body>
  <div class="row">
    <div class="col-8 offset-2">
      <h3 class="my-3">Title: <%= listing.title %></h3>
    </div>

    <div class="col-6 offset-2">
      <img
        src="<%= listing.image %>"
        class="show-image card-img-top my-2"
        alt="Listing image"
      />
      <div class="card-body">
        <p class="card-text">
          Description: <%= listing.description %><br />
          Price: <%= listing.price %><br />
          Location: <%= listing.location %><br />
          Country: <%= listing.country %><br />
        </p>

        <div class="btns col-6">
          <a
            class="btn btn-dark edit-btn"
            href="/listing/<%= listing._id %>/edit"
            >EDIT</a
          >
          <form
            method="POST"
            action="/listing/<%= listing._id %>?_method=DELETE"
            style="display: inline"
          >
            <button class="btn btn-dark">DELETE</button>
          </form>
        </div>
      </div>
      <hr />

      <div class="mb-3">
        <h4 class="mb-3">Leave a Review</h4>
        <form
          action="/listing/<%= listing._id %>/reviews"
          method="POST"
          class="needs-validation"
          novalidate
        >
          <div class="mb-3">
            <label for="rating" class="form-label">Rating:</label>
            <input
              type="range"
              min="1"
              max="5"
              id="rating"
              name="review[rating]"
              class="form-range"
              required
            />
          </div>

          <div class="mb-3">
            <label for="comment" class="form-label">Comment:</label>
            <textarea
              name="review[comment]"
              id="comment"
              cols="30"
              rows="4"
              class="form-control"
              required
            ></textarea>
            <div class="invalid-feedback">Comment is required.</div>
          </div>

          <button class="btn btn-outline-dark mt-3" type="submit">
            Submit
          </button>
        </form>
      </div>
      <hr />
      <div class="row">
        <p><b>All Reviews</b></p>
        <% for (let review of listing.reviews) { %>
        <div class="col-lg-6 col-12 mb-3 d-flex">
          <div class="card p-2 w-100 d-flex flex-column">
            <div class="card-body d-flex flex-column justify-content-between">
              <h5 class="card-title">John Doe</h5>
              <p class="card-text flex-grow-1"><%= review.comment %></p>
              <p class="card-text">
                <strong>Rating:</strong> <%= review.rating %>/5
              </p>
            </div>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</body>
