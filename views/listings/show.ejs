<% layout("/layouts/boilerplate") %>

<body>
  <div class="container my-4">
    <div class="row">
      <div class="col-8 offset-2">
        <h3 class="my-3">Title: <%= listing.title %></h3>
      </div>

      <div class="col-8 offset-2">
        <img
          src="<%= listing.image %>"
          class="show-image card-img-top show-card-img my-2"
          alt="Listing image"
        />

        <div class="card-body">
          <p class="card-text">
            <strong>Owned By:</strong> <i> <%= listing.owner.username %></i>
            <br />
            <strong>Description:</strong> <%= listing.description %><br />
            <strong>Price:</strong> <%= listing.price %><br />
            <strong>Location:</strong> <%= listing.location %><br />
            <strong>Country:</strong> <%= listing.country %><br />
          </p>
          <% if(currUser && currUser._id.equals(listing.owner._id)){%>
          <div class="btns d-flex gap-2 mb-3">
            <a
              class="btn btn-dark edit-btn"
              href="/listing/<%= listing._id %>/edit"
              >EDIT</a
            >
            <form
              method="POST"
              action="/listing/<%= listing._id %>?_method=DELETE"
              style="display: inline"
            >
              <button class="btn btn-dark">DELETE</button>
            </form>
          </div>
          <%}%>
        </div>

        <hr />
        <%if(currUser){%>
        <!-- Leave a Review -->
     <div class="mb-4">
  <h4 class="mb-3">Leave a Review</h4>
  <form
    action="/listing/<%= listing._id %>/reviews"
    method="POST"
    class="needs-validation"
    novalidate
  >
    <div class="mb-3">
      <label for="rating" class="form-label d-block">Rating:</label>
      <fieldset class="starability-slot">
        <!-- Optional: keep this for "no rating", but it won't show visually -->
        <input
          type="radio"
          id="no-rate"
          class="input-no-rate"
          name="review[rating]"
          value="0"
          aria-label="No rating."
        />

        <!-- 5 visible stars -->
        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
        <label for="first-rate1" title="Terrible">1 star</label>

        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
        <label for="first-rate2" title="Not good">2 stars</label>

        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
        <label for="first-rate3" title="Average">3 stars</label>

        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
        <label for="first-rate4" title="Very good">4 stars</label>

        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
        <label for="first-rate5" title="Amazing">5 stars</label>
      </fieldset>
    </div>

    <div class="mb-3">
      <label for="comment" class="form-label">Comment:</label>
      <textarea
        name="review[comment]"
        id="comment"
        cols="30"
        rows="4"
        class="form-control"
        required
      ></textarea>
      <div class="invalid-feedback">Comment is required.</div>
    </div>

    <button class="btn btn-outline-dark mt-3" type="submit">
      Submit
    </button>
  </form>
</div>
<hr />


        <%}%>

        <!-- All Reviews -->
        <h5 class="mb-3"><b>All Reviews</b></h5>
        <div class="row">
          <% for (let review of listing.reviews) { %>
          <div class="col-lg-6 col-12 mb-3 d-flex">
            <div class="comment-card card p-2 w-100 d-flex flex-column border">
              <div class="card-body d-flex flex-column justify-content-between">
                <h6 class="card-title"><%= review.author.username%></h6>
                <p class="card-text flex-grow-1"><%= review.comment %></p>
                <div class="d-flex justify-content-between align-items-center">
                  <p
                    class="starability-result card-text mb-0 small-stars"
                    data-rating="<%= review.rating %>"
                  >
                    Rated: 3 stars
                  </p>

                  <% if(currUser && review.author._id.equals(currUser._id)){%>
                  <form
                    action="/listing/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE"
                    method="POST"
                  >
                    <button class="btn btn-sm p-1">
                      <%- include('../includes/icons/delete') %>
                    </button>
                  </form>
                  <%}%>
                </div>
              </div>
            </div>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</body>
