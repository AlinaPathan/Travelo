<%layout("/layouts/boilerplate")%>

<body>
    <div class="row">
        <div class="col-8 offset-2">
            <h3>Listing Details</h3>
        </div>
    </div>

            <div class="card col-6 offset-2" >
                <img src="<%=listing.image%>" class="show-image card-img-top" alt="Listing image">
                <div class="card-body">
                  <p class="card-text">Title:<%=listing.title%></p>
                </div>
              </div>
        
      


    <ul>
        <li>Title:<%=listing.title%></li>
        <li>Description<%=listing.description%></li>
        <li>Price: <%=listing.price%></li>
        <li>Location<%=listing.location%></li>
        <li>Country<%=listing.country%></li>
    </ul>
    <a href="/listing/<%=listing._id%>/edit">Edit</a>
    <form  method="POST" action="/listing/<%=listing._id%>?_method=DELETE">
        <button>DELETE</button>
    </form>
</div>
</div>

</body>
</html>